<?xml version="1.0" encoding="UTF-8"?>
<!--
  Echelon 3 - IIS settings (the equivalent of the .htaccess files used by Apache).
  Apache and nginx ignore this file. It blocks direct requests to the configuration, logs and
  internal folders. Needs the IIS "Request Filtering" feature (installed by default).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="inc" />
          <add segment="classes" />
          <add segment="cron" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".inc" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- mapcycle links are read and written by Echelon only -->
  <location path="mapcycle">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <add fileExtension=".txt" allowed="false" />
            <add fileExtension=".cfg" allowed="false" />
            <add fileExtension=".previous" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- logs, caches and the GeoIP / GeoLite2 databases are read by PHP, never by browsers -->
  <location path="lib">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <add fileExtension=".txt" allowed="false" />
            <add fileExtension=".log" allowed="false" />
            <add fileExtension=".dat" allowed="false" />
            <add fileExtension=".json" allowed="false" />
            <add fileExtension=".mmdb" allowed="false" />
            <add fileExtension=".part" allowed="false" />
            <add fileExtension=".lock" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- the MaxMind reader library is PHP code that must never be requested directly -->
  <location path="lib/maxmind-db">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <add fileExtension=".php" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- pictures only: never run scripts from the images folder -->
  <location path="images">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <add fileExtension=".php" allowed="false" />
            <add fileExtension=".phtml" allowed="false" />
            <add fileExtension=".phar" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
